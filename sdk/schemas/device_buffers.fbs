namespace hipdnn_sdk.data_objects;

table DeviceBuffer {
    uid: int64;
    ptr: uint64;
}

table DeviceBuffers {
    io_buffers: [DeviceBuffer] (required);
    workspace_ptr: uint64;
}

root_type DeviceBuffers;
